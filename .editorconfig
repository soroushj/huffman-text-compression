root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,slnx,json,md,yml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning

# Test data must not be reformatted
[tests/**/data/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
